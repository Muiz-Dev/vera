generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Developer {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  password                String
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  applications            Application[]
  organizationMembers     OrganizationMember[]
  organizationInvitations OrganizationInvitation[]
  organizationActivities  OrganizationActivity[]

  @@map("developers")
}

model Application {
  id              String        @id @default(cuid())
  developerId     String
  developer       Developer     @relation(fields: [developerId], references: [id], onDelete: Cascade)
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  slug            String        @unique
  logoPlaceholder String?
  description     String?
  status          String        @default("ACTIVE") // ACTIVE, DISABLED
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  environments    Environment[]

  @@map("applications")
}

model Organization {
  id              String                   @id @default(cuid())
  name            String
  slug            String                   @unique
  description     String?
  logoPlaceholder String?
  website         String?
  metadata        Json?                    @default("{}")
  status          String                   @default("ACTIVE") // ACTIVE, SUSPENDED, DELETED
  deletedAt       DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  members         OrganizationMember[]
  applications    Application[]
  invitations     OrganizationInvitation[]
  activities      OrganizationActivity[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  developerId    String
  role           String       // OWNER, ADMINISTRATOR, MANAGER, DEVELOPER, BILLING, VIEWER
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  developer      Developer    @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, developerId])
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String       // Invited developer's email
  role           String       @default("DEVELOPER") // OWNER, ADMINISTRATOR, MANAGER, DEVELOPER, BILLING, VIEWER
  token          String       @unique
  invitedById    String
  status         String       @default("PENDING") // PENDING, ACCEPTED, REVOKED, EXPIRED
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      Developer    @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@map("organization_invitations")
}

model OrganizationActivity {
  id             String       @id @default(cuid())
  organizationId String
  developerId    String?
  action         String       // e.g. OrganizationCreated, MemberInvited, InvitationAccepted, MemberRemoved, OwnershipTransferred
  details        Json?        @default("{}")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  developer      Developer?   @relation(fields: [developerId], references: [id], onDelete: SetNull)

  @@map("organization_activity")
}

enum EnvironmentType {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

model Environment {
  id            String          @id @default(cuid())
  applicationId String
  application   Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  name          String
  slug          String          // e.g. "development", "staging", "production"
  type          EnvironmentType
  status        String          @default("ACTIVE") // ACTIVE, DISABLED
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  apiKeys       ApiKey[]
  origins       AllowedOrigin[]
  settings      ApplicationSettings?
  identities    Identity[]
  roles         Role[]
  permissions   Permission[]
  policies      Policy[]

  @@unique([applicationId, type])
  @@map("environments")
}

enum ApiKeyType {
  PUBLISHABLE
  SECRET
}

model ApiKey {
  id            String      @id @default(cuid())
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  token         String      @unique // Secure random string with prefix
  type          ApiKeyType
  prefix        String      // e.g. "pk_dev_", "sk_dev_"
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastUsedAt    DateTime?
  revokedAt     DateTime?

  @@map("api_keys")
}

model AllowedOrigin {
  id            String      @id @default(cuid())
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  origin        String      // e.g. "http://localhost:3000"
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([environmentId, origin])
  @@map("allowed_origins")
}

model ApplicationSettings {
  id                         String      @id @default(cuid())
  environmentId              String      @unique
  environment                Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  jwtAccessTokenLifetime     Int         @default(900)  // default 15 minutes (in seconds)
  refreshTokenLifetime       Int         @default(2592000) // default 30 days (in seconds)
  sessionTimeout             Int         @default(86400) // default 24 hours (in seconds)
  passwordPolicyMinLength    Int         @default(8)
  passwordPolicyRequireUpper Boolean     @default(true)
  passwordPolicyRequireLower Boolean     @default(true)
  passwordPolicyRequireNumber Boolean    @default(true)
  passwordPolicyRequireSymbol Boolean    @default(true)
  emailVerificationRequired  Boolean     @default(true)
  mfaRequired                Boolean     @default(false)
  webhookSecret              String?
  rateLimitingRequests       Int         @default(100)
  rateLimitingWindow         Int         @default(60) // in seconds
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  @@map("application_settings")
}

enum IdentityStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Identity {
  id            String          @id @default(cuid())
  environmentId String
  environment   Environment     @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  email         String?
  phone         String?
  status        IdentityStatus  @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  profile            IdentityProfile?
  credential         Credential?
  sessions           Session[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  mfaSecret          MfaSecret?
  roles              IdentityRole[]

  @@unique([environmentId, email])
  @@unique([environmentId, phone])
  @@map("identities")
}

model Role {
  id            String         @id @default(cuid())
  environmentId String
  environment   Environment    @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  description   String?
  isSystem      Boolean        @default(false)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  permissions RolePermission[]
  identities  IdentityRole[]

  @@unique([environmentId, slug])
  @@map("roles")
}

model Permission {
  id            String           @id @default(cuid())
  environmentId String
  environment   Environment      @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  name          String           // immutable string: domain.resource.action
  displayName   String
  description   String?
  isSystem      Boolean          @default(false)
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  roles       RolePermission[]

  @@unique([environmentId, name])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model IdentityRole {
  identityId String
  roleId     String
  createdAt  DateTime @default(now())

  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([identityId, roleId])
  @@map("identity_roles")
}

model Policy {
  id            String      @id @default(cuid())
  environmentId String
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  isSystem      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([environmentId, name])
  @@map("policies")
}

model IdentityProfile {
  id          String   @id @default(cuid())
  identityId  String   @unique
  identity    Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  firstName   String?
  lastName    String?
  avatar      String?
  displayName String?
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("identity_profiles")
}

model Credential {
  id         String   @id @default(cuid())
  identityId String   @unique
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)
  password   String   // Argon2id hash
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("credentials")
}

model Session {
  id            String         @id @default(cuid())
  identityId    String
  identity      Identity       @relation(fields: [identityId], references: [id], onDelete: Cascade)
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastActiveAt  DateTime       @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?      // Nullable, if set, the session is fully revoked
  refreshTokens RefreshToken[]

  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  sessionId String
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  token     String    @unique // Secure random token / hash for verification
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime? // Tracked for token rotation and security detection (reuse of revoked token)

  @@map("refresh_tokens")
}

model EmailVerification {
  id         String    @id @default(cuid())
  identityId String
  identity   Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  token      String    @unique // Secure random verification token
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("email_verifications")
}

model PasswordReset {
  id         String    @id @default(cuid())
  identityId String
  identity   Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  token      String    @unique // Secure random reset token
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@map("password_resets")
}

model MfaSecret {
  id         String    @id @default(cuid())
  identityId String    @unique
  identity   Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)
  secret     String    // Encrypted secret key
  isEnabled  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("mfa_secrets")
}
